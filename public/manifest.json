{
  "manifest_version": 3,
  "name": "Listing Guard",
  "version": "0.1.0",
  "description": "Kiểm tra listing Etsy trước khi đăng bằng Listing Guard API.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.etsy.com/your/shops/me/tools/listings/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.etsy.com/your/shops/me/tools/listings/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/index.html"
}
